    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/lib-storage": "^3.1170.0",
    "@aws-sdk/s3-presigned-post": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@tailwindcss/vite": "^4.3.0",
    "dotenv": "^18.0.10",
    "files-sdk": "^3.2.0",
