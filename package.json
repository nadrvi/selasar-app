{
  "name": "selasar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "vite",
    "dev:backend": "node --watch --env-file=backend/.env backend/src/index.js",
