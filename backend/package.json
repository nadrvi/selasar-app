{
  "name": "selasar-backend",
  "version": "1.0.0",
  "description": "Backend REST API for Selasar App using Hono.js, PostgreSQL (Neon), and S3 Storage",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate:harden-backend": "tsx --env-file=.env src/migrations/harden_backend.ts",
    "migrate:secure-seed-accounts": "tsx --env-file=.env src/migrations/secure_seed_accounts.ts",
    "migrate:clear-legacy-password-hashes": "tsx --env-file=.env src/migrations/clear_legacy_password_hashes.ts",
    "migrate:community-reviews": "tsx --env-file=.env src/migrations/community_reviews_migration.ts",
    "seed:hours": "tsx --env-file=.env src/migrations/seed_hours.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@aws-sdk/s3-presigned-post": "^3.750.0",
    "@hono/node-server": "^2.1.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "hono": "^4.7.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
