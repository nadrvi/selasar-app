{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "selasar-app",
	"main": "./worker.js",
	"compatibility_date": "2026-11-20",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api",
			"/api/*",
			"/health/db"
		]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "6053431c0a944b77ab15ff52d4fae953",
			"localConnectionString": "postgresql://selasar:selasar@localhost:5432/selasar"
		}
	],
	"vars": {
		"NODE_ENV": "production",
		"FIREBASE_PROJECT_ID": "loginprojectregister",
		"AWS_ENDPOINT_URL_S3": "https://br-falling-fog-b3nc922j.storage.c-4.ap-southeast-1.aws.neon.tech",
		"AWS_REGION": "ap-southeast-1",
		"S3_BUCKET_NAME": "selasar-assets"
	}
}